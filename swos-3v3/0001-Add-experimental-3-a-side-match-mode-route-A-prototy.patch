+namespace OpenSwos.Sim.Port;
+
+using OpenSwos.SwosVm;
+
+// PORT-ONLY EXPERIMENT — small-sided (3-a-side) match mode. Not in the
+// original game.
+//
+// Route: instead of resizing the 11-per-team sprite pool / tactics tables,
+// the 8 surplus outfielders per team are marked exactly like red-carded
+// players (sentAway = 1, cards = -1) and parked at the sent-off spot
+// (Referee.kSentOffPlayerX/Y) at pitch entry. Every system that already
+// excludes sent-off players then does the right thing for free:
+//
+//   - controlled-player election skips them  (InputControls.cs sentAway gate)
+//   - pass-target election skips them        (UpdatePlayerBeingPassedTo)
+//   - set-piece taker scans skip them        (SetPieces.FindNearestOutfielderToPoint)
+//   - break repositioning skips them         (UpdatePlayers l_check_if_sent_away)
+//   - free-kick wall math shifts around them (cards < 0 treated as red card)
+//   - Mode3 arrival wait passes              (they stand at dest, drs promotes)
+//
+// The remaining holes (in-play tactical repositioning, the port-only
+// re-election stand-in, the renderer, the bench) are patched at their sites,
+// each gated on `Enabled` so 11-a-side behaviour — and the recorded golden
+// traces / RNG stream — stay byte-identical when the mode is off.
+public static class SmallSided
+{
+    // Toggled from the match-setup menu (Main.cs "mode" slot). Read at pitch
+    // entry (Kickoff.InitPlayersBeforeEnteringPitch), so flipping it only
+    // takes effect on the next match start.
+    public static bool Enabled = false;
+
+    // On-pitch players per team including the goalkeeper: GK + 2 outfielders.
+    // Kept players are sprite-table slots 0..OnPitchPerTeam-1 within each
+    // team (slot 0 = keeper, then outfielder ordinals 2, 3 — tactics rows 0
+    // and 1 of whatever formation is selected).
+    public const int OnPitchPerTeam = 3;
+
+    // slotInTeam is the per-team sprite-table index 0..TeamSize-1.
+    public static bool IsGhostIndex(int slotInTeam)
+        => Enabled && slotInTeam >= OnPitchPerTeam;
+
+    // slot is the global sprite-pool slot 0..TotalSlots-1 (0..10 top team,
+    // 11..21 bottom team).
+    public static bool IsGhostGlobalSlot(int slot)
+    {
+        int slotInTeam = slot < PlayerSprite.TeamSize
+            ? slot
+            : slot - PlayerSprite.TeamSize;
+        return IsGhostIndex(slotInTeam);
+    }
+}
